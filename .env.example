# DATABASE
DATABASE_URL=postgresql://orekit:changeme@db:5432/orekit

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# TLE INGESTION
TLE_FETCH_INTERVAL_HOURS=6
TLE_GROUPS=stations, active
TLE_FETCH_TIMEOUT_SECONDS=30
TLE_MAX_RETRIES=3
TLE_RETRY_MAX_WAIT=10

# API
API_HOST=0.0.0.0
API_PORT=8000

# CI (registry path for Docker image, used by the maintener)
CI_REGISTRY_IMAGE=ghcr.io/v-lmb/orekit-website-api
